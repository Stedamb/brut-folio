---
// Lab experiment: Berlin as a tilt-shift ASCII diorama, tried for the homepage hero.
// Listed on /lab; a full-screen page of its own, with a way back.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Berlin in miniature: a tilt-shift diorama in coloured ASCII." />
    <title>Berlin in miniature | Lab</title>
    <style>
      html,
      body {
        margin: 0;
        height: 100%;
        background: #050505;
      }
      [data-diorama] {
        position: fixed;
        inset: 0;
      }
      .back {
        position: fixed;
        top: 16px;
        left: 16px;
        z-index: 1;
        padding: 4px 8px;
        font: 13px/1.4 ui-monospace, Menlo, Consolas, monospace;
        color: #f5f5f5;
        background: rgb(5 5 5 / 0.6);
        text-decoration: none;
      }
      .back:hover {
        text-decoration: underline;
      }
    </style>
  </head>
  <body>
    <a class="back" href="/lab">&larr; Lab</a>
    <div data-diorama></div>
    <script>
      import { initDiorama } from '../../scripts/diorama/main.js';

      const host = document.querySelector<HTMLElement>('[data-diorama]');
      if (host) initDiorama(host).catch((error) => console.error('[diorama]', error));
    </script>
  </body>
</html>
