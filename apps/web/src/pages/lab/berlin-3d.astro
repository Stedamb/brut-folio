---
// Lab experiment: Berlin 3D, in coloured ASCII. It opens on the city seen from high above
// through a tilt-shift lens; E or the button flies down to walk its streets. Listed on /lab.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Berlin 3D, in coloured ASCII: the city from above, and its streets on foot." />
    <title>Berlin 3D | Lab</title>
    <style>
      html,
      body {
        margin: 0;
        height: 100%;
        background: #050505;
        overflow: hidden;
      }
      [data-berlin] {
        position: fixed;
        inset: 0;
      }
      .ui {
        position: fixed;
        z-index: 1;
        padding: 6px 10px;
        font: 13px/1.4 ui-monospace, Menlo, Consolas, monospace;
        color: #f5f5f5;
        background: rgb(5 5 5 / 0.65);
        border: 0;
        text-decoration: none;
      }
      a.ui:hover,
      button.ui:hover {
        text-decoration: underline;
        cursor: pointer;
      }
      .back {
        top: 16px;
        left: 16px;
      }
      .switch {
        top: 16px;
        right: 16px;
      }
      .hint {
        bottom: 16px;
        left: 50%;
        transform: translateX(-50%);
        margin: 0;
        text-align: center;
        pointer-events: none;
        transition: opacity 1s;
      }
      /* Each mode shows its own controls; nothing to press while flying. */
      [data-for] {
        display: none;
      }
      body[data-mode='above'] [data-for~='above'],
      body[data-mode='walk'] [data-for~='walk'] {
        display: block;
      }
      body.quiet .hint {
        opacity: 0;
      }
      .touch {
        display: none;
      }
      @media (pointer: coarse) {
        .touch {
          display: inline;
        }
        .mouse {
          display: none;
        }
      }
    </style>
  </head>
  <body data-mode="above">
    <a class="ui back" href="/lab">&larr; Lab</a>
    <button class="ui switch" type="button" data-for="above" data-enter>Walk the streets &darr;</button>
    <button class="ui switch" type="button" data-for="walk" data-leave>&uarr; Fly back up</button>
    <p class="ui hint" data-for="above"><span class="mouse">E to step into the city &middot; Space to pause &middot; R for 3D</span><span class="touch">tap the button to step into the city</span></p>
    <p class="ui hint" data-for="walk">
      <span class="mouse">click to look around &middot; WASD or arrows to walk &middot; Shift to hurry &middot; Esc to fly back up &middot; R for 3D</span>
      <span class="touch">drag left to walk &middot; drag right to look</span>
    </p>
    <div data-berlin></div>
    <script>
      import { initBerlin } from '../../scripts/berlin-3d/main.js';

      const host = document.querySelector<HTMLElement>('[data-berlin]');
      let quiet = 0;
      const onMode = (mode: string) => {
        document.body.dataset.mode = mode;
        // The controls show for a while in each mode, then fade until the mode changes.
        document.body.classList.remove('quiet');
        clearTimeout(quiet);
        quiet = window.setTimeout(() => document.body.classList.add('quiet'), 9000);
      };
      if (host) {
        initBerlin(host, { onMode })
          .then((berlin) => {
            document.querySelector('[data-enter]')?.addEventListener('click', () => berlin.enter());
            document.querySelector('[data-leave]')?.addEventListener('click', () => berlin.leave());
          })
          .catch((error) => console.error('[berlin]', error));
      }
    </script>
  </body>
</html>
